FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt
COPY fast_simulator/ fast_simulator/
COPY simulator_api.py .
COPY market_index.parquet market_proxies.parquet mutualfunds_data.csv ./
EXPOSE 8000
HEALTHCHECK --start-period=120s --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health',timeout=4)"
CMD ["uvicorn", "simulator_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
